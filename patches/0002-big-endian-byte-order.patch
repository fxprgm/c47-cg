+#if !defined(DECLITEND)
+  #define DECLITEND 1 // decNumberLocal.h's default
+#endif // !DECLITEND
+
+void programLiteralFromUInt64(uint8_t *literal, uint64_t value) {
+  for(unsigned int i = 0; i < sizeof(uint64_t); ++i) {
+    literal[i] = (uint8_t)(value >> (8 * i));
+  }
+}
+
+uint64_t programLiteralToUInt64(const uint8_t *literal) {
+  uint64_t value = 0;
+  for(unsigned int i = sizeof(uint64_t); i > 0; --i) {
+    value = (value << 8) | literal[i - 1];
+  }
+  return value;
+}
+
+void programLiteralFromReal34(uint8_t *literal, const real34_t *value) {
+  const uint8_t *bytes = (const uint8_t *)value;
+  for(unsigned int i = 0; i < REAL34_SIZE_IN_BYTES; ++i) {
+    literal[i] = bytes[DECLITEND ? i : REAL34_SIZE_IN_BYTES - 1 - i];
+  }
+}
+
+void programLiteralToReal34(const uint8_t *literal, real34_t *value) {
+  uint8_t *bytes = (uint8_t *)value;
+  for(unsigned int i = 0; i < REAL34_SIZE_IN_BYTES; ++i) {
+    bytes[DECLITEND ? i : REAL34_SIZE_IN_BYTES - 1 - i] = literal[i];
+  }
+}
+
