   bool_t         checkOpCodeOfStep             (const uint8_t *step, uint16_t op);
 
+  // Program literals (BINARY_SHORT_INTEGER, BINARY_REAL34, BINARY_COMPLEX34) are stored little-endian, the byte order every C47 has written them in:
+  // program memory goes byte for byte into program files, state files and testPgms.bin, so a big-endian CPU (or a DECLITEND=0 decNumber, whose
+  // decQuads are big-endian) converts at the two ends instead of writing its own order.
+  void           programLiteralFromUInt64      (uint8_t *literal, uint64_t value);
